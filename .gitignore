# Dependencies
node_modules/

# Rust / Tauri build artifacts
src-tauri/target/
src-tauri/gen/
# Note: src-tauri/Cargo.lock IS committed intentionally for reproducible
# builds (release gate requires a resolved lockfile). Do not ignore it.

# Build artifacts (the hand-assembled .app is 200M+; rebuild locally)
dist/
*.app/

# Local runtime state (never lives in the repo, but guard anyway)
.octopus/
usage.json

# Editor / local project config
.claude/
.vscode/
.idea/

# Image iteration backups (not part of the shipped art)
assets/_orig_mascot/

# OS / logs
.DS_Store
*.log
npm-debug.log*

# R40.4: Environment files must never be committed
.env
.env.*
!.env.example
