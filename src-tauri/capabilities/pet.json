{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet",
  "description": "Least-privilege commands used by the always-on desktop pet window.",
  "windows": [
    "pet"
  ],
  "permissions": [
    "core:default",
    "allow-get-config",
    "allow-get-stats",
    "allow-get-win-pos",
    "allow-set-win-pos",
    "allow-set-ignore-mouse",
    "allow-set-pet-size",
    "allow-set-skin",
    "allow-set-currency",
    "allow-toggle-mute",
    "allow-territory-run-now",
    "allow-open-panel",
    "allow-blur-pet",
    "allow-decide-permission",
    "allow-decide-permission-batch",
    "allow-launch-agent",
    "allow-focus-session",
    "allow-primary-action",
    "allow-open-log",
    "allow-pet-log",
    "allow-ui-busy",
    "allow-pet-visual-bounds",
    "allow-quit-app"
  ]
}
