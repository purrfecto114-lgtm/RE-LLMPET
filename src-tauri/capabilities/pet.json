{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet",
  "description": "Least-privilege commands used by the always-on desktop pet window.",
  "windows": [
    "pet",
    "pet-codex"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "allow-get-config",
    "allow-set-language",
    "allow-get-stats",
    "allow-get-win-pos",
    "allow-set-win-pos",
    "allow-commit-win-pos",
    "allow-set-ignore-mouse",
    "allow-set-pet-size",
    "allow-set-skin",
    "allow-set-currency",
    "allow-toggle-mute",
    "allow-territory-run-now",
    "allow-open-panel",
    "allow-blur-pet",
    "allow-focus-pet",
    "allow-decide-permission",
    "allow-decide-permission-batch",
    "allow-diagnose-agent",
    "allow-launch-agent",
    "allow-launch-agent-gui",
    "allow-focus-session",
    "allow-primary-action",
    "allow-open-log",
    "allow-pet-log",
    "allow-ui-busy",
    "allow-pet-visual-bounds",
    "allow-quit-app",
    "allow-set-session-prefs",
    "allow-set-session-pref",
    "allow-set-pet-mode",
    "allow-get-travel",
    "allow-start-travel",
    "allow-start-wander",
    "allow-set-wander-missions",
    "allow-cancel-travel"
  ]
}
