{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "Least-privilege commands used by the details and configuration panel.",
  "windows": [
    "panel"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "allow-get-config",
    "allow-set-language",
    "allow-get-stats",
    "allow-get-price-info",
    "allow-refresh-model-prices",
    "allow-set-price-auto-update",
    "allow-rebuild-usage-costs",
    "allow-set-mode",
    "allow-set-skin",
    "allow-set-budget",
    "allow-set-providers",
    "allow-set-session-prefs",
    "allow-set-session-pref",
    "allow-close-panel",
    "allow-set-panel-height",
    "allow-diagnose-agent",
    "allow-cancel-diagnostic",
    "allow-launch-agent",
    "allow-launch-agent-gui",
    "allow-get-config-state",
    "allow-backup-and-reset-config",
    "allow-get-install-receipts",
    "allow-set-pet-mode",
    "allow-get-travel",
    "allow-set-wander-missions"
  ]
}
